DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rentalmobil
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-secure-secret
ML_SERVICE_BASE_URL=http://127.0.0.1:8000

# Opsional: origin tambahan yang diizinkan Better Auth (dipisah koma).
# Origin localhost (port berapa pun) otomatis dipercaya saat mode development.
AUTH_TRUSTED_ORIGINS=

# Opsional: jika keduanya diset, `npm run db:seed` otomatis membuat/memperbarui
# akun admin (password minimal 8 karakter). Kosongkan untuk melewati.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
